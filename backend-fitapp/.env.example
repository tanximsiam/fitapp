APP_NAME=FitApp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Frontend origins allowed by CORS (comma-separated)
FRONTEND_ORIGINS=http://localhost:8100,http://localhost:5173

# Website URL the browser returns to after connecting Zepp (defaults to the first FRONTEND_ORIGINS entry)
FRONTEND_URL=http://localhost:5173

# --- Zepp Open Platform (https://devopen.zepp.com) ---------------------------------------------
# Leave empty until Zepp has approved your partner application. See docs/zepp.md.
# Client credentials from the Zepp Developer Console (keep the secret on the server only):
ZEPP_CLIENT_ID=
ZEPP_CLIENT_SECRET=
# OAuth callback; register exactly this URL in the Zepp Developer Console:
ZEPP_REDIRECT_URI="${APP_URL}/api/zepp/callback"
# Random secret path segment for the event webhook (e.g. `php -r "echo bin2hex(random_bytes(24));"`).
# Register ${APP_URL}/api/zepp/webhook/<this value> as the event callback URL in the console.
ZEPP_WEBHOOK_TOKEN=
# Defaults follow Zepp's documentation; change only if Zepp gives you different hosts.
# ZEPP_AUTHORIZE_URL="https://user.zepp.com/oauth2/index.html#/login"
# ZEPP_TOKEN_URL=https://auth.zepp.com/v2/oauth2/access_token
# ZEPP_REFRESH_URL=https://auth.zepp.com/v2/oauth2/refresh_token
# ZEPP_API_BASE=https://api-open.zepp.com
# Days of minute heart-rate readings pulled by the scheduled `fitapp:zepp-sync`
ZEPP_HEART_RATE_DAYS=2
