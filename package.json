  "version": "0.1.0",
  "type": "module",
  "description": "FitApp mobile: watch-centred holistic health app for Android and iOS (Ionic Vue + Capacitor)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:contract": "vitest run tests/contract",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.vue --fix",
    "sync": "npm run build && cap sync"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "7.1.6",
    "@capacitor/android": "7.3.0",
    "@capacitor/app": "7.0.1",
    "@capacitor/core": "7.3.0",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/haptics": "7.0.1",
    "@capacitor/ios": "7.3.0",
    "@capacitor/keyboard": "7.0.1",
    "@capacitor/network": "7.0.4",
    "@capacitor/status-bar": "7.0.1",
    "@ionic/vue": "^8.0.0",
    "@ionic/vue-router": "^8.0.0",
    "@tailwindcss/vite": "^4.1.8",
    "axios": "^1.9.0",
    "capacitor-health": "7.1.0",
    "ionicons": "^7.0.0",
    "pinia": "^3.0.3",
    "tailwindcss": "^4.1.8",
    "vue": "^3.3.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.3.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.3.0",
    "eslint": "^8.35.0",
    "eslint-plugin-vue": "^9.9.0",
    "jsdom": "^22.1.0",
    "terser": "^5.4.0",
    "typescript": "~5.6.2",
    "vite": "~5.2.0",
    "vitest": "^0.34.6",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "node": ">=20"
  }
